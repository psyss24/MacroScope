# Frontend production API endpoint override.
# Copy values into your production environment before building.
# Example Oracle backend domain:
REACT_APP_API_BASE_URL=https://api.saadsaqib.dev/api

# Phase-2 experimental mobile macro UI (desktop remains unchanged)
# Set to true to enable on <=767px screens.
REACT_APP_ENABLE_MOBILE_MACRO=true

# Phase-3 experimental mobile markets UI (desktop remains unchanged)
REACT_APP_ENABLE_MOBILE_MARKETS=true

# Phase-4 experimental mobile bonds UI (desktop remains unchanged)
REACT_APP_ENABLE_MOBILE_BONDS=true

# Phase-5 mobile home dashboard UI (desktop remains unchanged)
REACT_APP_ENABLE_MOBILE_HOME=true
